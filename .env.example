# Neon database (REQUIRED). Tables are created automatically on first start.
# Neon Console -> your project -> Connect -> copy the *Pooled* connection string
DATABASE_URL=

# Public site URL (used for payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shop info
NEXT_PUBLIC_SHOP_NAME=DigitalShop
NEXT_PUBLIC_WHATSAPP=8801XXXXXXXXX

# SSLCommerz (sandbox: https://developer.sslcommerz.com/registration/)
SSLCZ_STORE_ID=your_store_id
SSLCZ_STORE_PASSWORD=your_store_password
SSLCZ_IS_LIVE=false

# Admin login (REQUIRED in production)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-strong-password
AUTH_SECRET=any-random-string-at-least-32-characters-long

# Only for testing a deployed site before SSLCommerz keys are added (never in real use)
# ALLOW_DEMO_PAYMENT=true

# ---- Optional: order notifications ----
# Telegram: create a bot with @BotFather, paste its token here; put your chat ID in Admin → Store settings
TELEGRAM_BOT_TOKEN=
# Email via https://resend.com (new-order emails to you + "delivered" emails to customers)
RESEND_API_KEY=
# RESEND_FROM="DigitalShop <orders@yourdomain.com>"   # needs a verified domain in Resend
